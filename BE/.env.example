# Backend environment variables: copy to BE/.env and fill in. EXAMPLE VALUES ONLY, never real
# secrets; BE/.env is git-ignored. Every variable of app/core/config/config.py (Settings) is listed
# here (tests/test_env_example.py checks it). Values shown are the defaults unless marked "fill in".

# ----- Environment (Mốc M7) -----
# dev | test | staging | production. Only "dev" allows DEBUG=true and the DEV-ONLY switches below.
APP_ENV=production
# true = tracebacks in the error log + the dev shortcuts. Refused at startup unless APP_ENV=dev AND
# the DATABASE_URL host is listed in DEV_DATABASE_HOSTS. Keep false everywhere but a dev machine.
DEBUG=false
# Database hosts (or host prefixes, e.g. a Neon endpoint id like ep-xxxx-xxxx-xxxxxxxx) a DEBUG
# process may use. Never list a production host here.
DEV_DATABASE_HOSTS=localhost,127.0.0.1,::1
# Level of the app's own log lines (mfg.*) on the console: DEBUG, INFO, WARNING...
LOG_LEVEL=INFO

# ----- Database (fill in) -----
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ----- Firebase (fill in) -----
FIREBASE_PROJECT_ID=your-firebase-project-id
# Web API key of the same Firebase project (Project settings > General), for the Auth REST API
# (password reset confirm, owner sign-up fallback). No default in code.
FIREBASE_API_KEY=your_firebase_web_api_key
# Service account JSON for the Admin API (path to a file OUTSIDE the repository).
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
FIREBASE_CALL_TIMEOUT_SECONDS=10

# ----- Sessions, front end -----
SESSION_TTL_HOURS=8
# No longer read (change-password checks the current password in the DB); kept for old .env files.
RECENT_LOGIN_MAX_AGE_SECONDS=300
# CORS: the exact origins of the front end, comma-separated (never "*").
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Login button of the Owner credentials e-mail.
FRONTEND_URL=http://localhost:5173
# Forgot-password e-mail (Mốc M4b): the link points to {FRONTEND_BASE_URL}/reset-password
FRONTEND_BASE_URL=http://localhost:5173

# ----- Rate limits (per caller address unless noted) -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTRATION_MAX=5
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
RATE_LIMIT_TRACK_MAX=20
RATE_LIMIT_TRACK_WINDOW_SECONDS=600
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
# OTP routes (send: register-send-otp + business send-otp share one counter; verify: the two
# verify-otp routes share another)
RATE_LIMIT_OTP_SEND_MAX=10
RATE_LIMIT_OTP_SEND_WINDOW_SECONDS=600
RATE_LIMIT_OTP_VERIFY_MAX=20
RATE_LIMIT_OTP_VERIFY_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_PUBLIC_MAX=5
RATE_LIMIT_REGISTER_PUBLIC_WINDOW_SECONDS=3600
# Forgot password, confirm: every call, and separately only the wrong / expired reset codes
RATE_LIMIT_PASSWORD_RESET_MAX=10
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=600
RATE_LIMIT_PASSWORD_RESET_FAILURES_MAX=5
RATE_LIMIT_PASSWORD_RESET_FAILURES_WINDOW_SECONDS=900
# Forgot password, request: per caller address and per target e-mail
RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX=5
RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_RESET_REQUEST_EMAIL_MAX=3
RATE_LIMIT_PASSWORD_RESET_REQUEST_EMAIL_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_KEYS=10000
# Behind a reverse proxy: trust X-Forwarded-For, and how many proxies are in front of the app.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1

# ----- Owner provisioning -----
PROVISIONING_LEASE_SECONDS=90
PROVISIONING_MAX_ATTEMPTS=5
OWNER_TEMP_PASSWORD_TTL_HOURS=72
OWNER_TEMP_PASSWORD_REQUIRE_SYMBOL=false

# ----- Outgoing e-mail (fill in): SMTP + STARTTLS. For Gmail SMTP_PASSWORD is an App Password. -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_address@gmail.com
SMTP_PASSWORD=your_smtp_app_password
# Domains no e-mail is ever sent to (comma-separated, sub-domains included). giapha.com = the Owners'
# login identifiers, a domain the team does not own.
BLOCKED_EMAIL_DOMAINS=giapha.com

# ----- Gmail registry (Mốc M5) -----
# DEV ONLY (refused at startup unless APP_ENV=dev): true keeps the "+tag" of Gmail addresses
# (name+test1@gmail.com != name@gmail.com) so aliases can be tested. Decide it BEFORE migration 0008
# (its backfill normalizes with this value) and keep the same value afterwards.
ALLOW_GMAIL_PLUS_ALIAS=false

# ----- E-mail OTP (registration, Mốc M5-1) -----
# Fill in: a random secret of 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty = the OTP routes answer 503 (in dev mode only, a fixed dev key is used).
OTP_HMAC_KEY=
# DEV ONLY (DEBUG=true and APP_ENV=dev): pretend the OTP e-mail was sent when SMTP is not configured.
OTP_DEV_SIMULATION=false
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_FAILED_ATTEMPTS=5
OTP_EMAIL_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_EMAIL=5
OTP_MAX_FAILURES_PER_EMAIL=10
OTP_VERIFIED_TOKEN_TTL_SECONDS=1800
