# Frontend Environment Variables (copy to FE/.env, never commit FE/.env)
#
# Không có giá trị dự phòng nào trong mã nguồn: biến nào cần mà thiếu thì FE báo lỗi cấu hình.

# Gốc API của BE, GỒM tiền tố /api/v1 (Mốc M2). FE gọi mọi API dưới /api/v1.
# Chỉ ghi http://localhost:8001 cũng được: FE tự thêm /api/v1 nếu thiếu.
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1

# Firebase (TÙY CHỌN). Từ Mốc M1/M4b FE không còn dùng Firebase: đăng nhập, đăng ký và quên mật
# khẩu đều đi qua BE (thư đặt lại mật khẩu do BE gửi, không dùng mẫu email của Firebase).
# Chỉ cần điền khi có tính năng FE gọi getFirebaseAuth() (src/config/firebase.ts); khi đó thiếu
# API_KEY / AUTH_DOMAIN / PROJECT_ID / APP_ID sẽ báo lỗi cấu hình. Lấy ở Firebase Console > Project
# settings > Your apps. Khóa web nên được giới hạn theo domain (HTTP referrer) trong Google Cloud.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
